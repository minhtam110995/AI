{
  "manifest_version": 3,
  "name": "Facebook Analyzer",
  "version": "1.0.0",
  "description": "Phân tích fanpage đối thủ và Reels trên Facebook: tương tác, bài bứt phá, giờ đăng, định dạng, hook, công thức viral, theo dõi đối thủ.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "notifications"],
  "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facebook Analyzer",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    { "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["src/inject.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"], "js": ["src/common.js", "src/content.js"], "run_at": "document_start" }
  ]
}
